# Single-user access: create a bcrypt hash; never put the plaintext password here.
AUTH_PASSWORD_HASH=

# Cryptographically random secret used to sign server sessions; keep private.
SESSION_SECRET=

# Existing AI, GitHub, Telegram and trading variables remain configured only in Render.

# Optional HTTPS gateway for signed Binance Global Spot API requests only.
# BorsaCI signs requests server-side and forwards the original /api/v3 pathname,
# signed query (GET/DELETE) or form body (POST) and X-MBX-APIKEY header.
# Do not expose this value to the browser. Leave empty to use direct Binance fallback.
BINANCE_PRIVATE_GATEWAY_URL=

# Required only for Telegram paper-trade approval buttons. Use a long random value.
TELEGRAM_WEBHOOK_SECRET=

# Public HTTPS address used to register the Telegram webhook. Render may provide RENDER_EXTERNAL_URL instead.
PUBLIC_BASE_URL=

# NASDAQ / Alpaca: values belong only in Render. Do not expose them to the browser.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
# Basic historical market-data feed. Keep SIP when available; IEX is an explicit fallback.
ALPACA_DATA_FEED=sip
# Paper is safe default. Never set live unintentionally.
ALPACA_TRADING_MODE=paper
# false keeps NASDAQ approvals local paper-only even when credentials exist.
ALPACA_TRADING_ENABLED=false
# Number of active/tradable NASDAQ symbols inspected per scan (50-1200).
NASDAQ_UNIVERSE_LIMIT=300
