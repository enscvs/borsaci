# Single-user access: create a bcrypt hash; never put the plaintext password here.
AUTH_PASSWORD_HASH=

# Cryptographically random secret used to sign server sessions; keep private.
SESSION_SECRET=

# Existing AI, GitHub, Telegram and trading variables remain configured only in Render.

# Optional HTTPS gateway for signed Binance Global Spot API requests only.
# BorsaCI signs requests server-side and forwards the original /api/v3 pathname,
# signed query (GET/DELETE) or form body (POST) and X-MBX-APIKEY header.
# Do not expose this value to the browser. Leave empty to use direct Binance fallback.
BINANCE_PRIVATE_GATEWAY_URL=
# Required when BINANCE_PRIVATE_GATEWAY_URL is set. Use the same long random
# value as the Cloudflare Worker secret BORSACI_GATEWAY_TOKEN. Never expose it.
BINANCE_PRIVATE_GATEWAY_TOKEN=

# Required only for Telegram paper-trade approval buttons. Use a long random value.
TELEGRAM_WEBHOOK_SECRET=

# Public HTTPS address used to register the Telegram webhook. Render may provide RENDER_EXTERNAL_URL instead.
PUBLIC_BASE_URL=

# NASDAQ / Alpaca: values belong only in Render. Do not expose them to the browser.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
# Basic historical market-data feed. Keep SIP when available; IEX is an explicit fallback.
ALPACA_DATA_FEED=sip
# Paper is safe default. Never set live unintentionally.
ALPACA_TRADING_MODE=paper
# false keeps NASDAQ approvals local paper-only even when credentials exist.
ALPACA_TRADING_ENABLED=false
# Number of active/tradable NASDAQ symbols inspected per scan (50-1200).
NASDAQ_UNIVERSE_LIMIT=300


# PWA Web Push (Apple Developer Program gerekmez).
# Bir kez `npx web-push generate-vapid-keys` ile üretin; private key'i yalnız Render'da saklayın.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
# mailto:operator@example.com veya sitenin HTTPS adresi.
WEB_PUSH_VAPID_SUBJECT=
# Render PostgreSQL internal connection URL. DATABASE_URL tanımlıysa bu alan opsiyoneldir.
WEB_PUSH_DATABASE_URL=
# Yalnız dış PostgreSQL bağlantısı TLS gerektiriyorsa true yapın.
WEB_PUSH_DATABASE_SSL=false
# Aynı olayın tekrar teslimini engelleme penceresi; varsayılan 10 dakika.
WEB_PUSH_DEDUPE_WINDOW_MS=600000

# OneSignal Web Push. OneSignal aboneliği ve teslimatı yönetir; PostgreSQL gerekmez.
# App ID gizli değildir. API anahtarı ve izinli cihaz ID'si yalnız sunucu environment'ında tutulur.
ONESIGNAL_APP_ID=37d4853e-17da-4ebe-9220-372f2964a8e4
ONESIGNAL_APP_API_KEY=
ONESIGNAL_ALLOWED_SUBSCRIPTION_ID=
ONESIGNAL_API_TIMEOUT_MS=5000
# İlk gerçek iPhone testi tamamlanana kadar legacy bırakın; sonra onesignal yapın.
# Sunucu aynı olay için yalnız seçili sağlayıcıya gönderir.
WEB_PUSH_PROVIDER=legacy
