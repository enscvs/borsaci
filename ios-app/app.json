{
  "expo": {
    "name": "𐰇𐰠𐰇𐱁",
    "slug": "borsaci-ios",
    "version": "1.0.1",
    "icon": "./icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./icon.png",
      "supportsTablet": false,
      "bundleIdentifier": "com.enscvs.borsaci.personal",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Borsacı uygulamasını yalnızca sizin açabilmeniz için Face ID kullanılır."
      },
      "buildNumber": "2"
    },
    "plugins": [
      "expo-local-authentication",
      "expo-secure-store"
    ],
    "updates": {
      "fallbackToCacheTimeout": 0
    }
  }
}
